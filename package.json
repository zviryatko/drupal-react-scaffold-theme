{
  "name": "react-scaffold",
  "version": "1.0.0",
  "description": "Drupal base theme: React islands as core Single Directory Components, shared Vite and Jest config for subthemes.",
  "type": "module",
  "exports": {
    "./vite": "./vite.base.js",
    "./jest": "./jest.base.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "vite.base.js",
    "vite-plugin-copy-react.js",
    "jest.base.cjs",
    "test",
    "src",
    "scripts",
    "starter"
  ],
  "dependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite-plugin-external": "^6.2.2",
    "autoprefixer": "^10.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "babel-jest": "^30.1.2",
    "jest-environment-jsdom": "^30.5.2",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.8.0"
  },
  "devDependencies": {
    "vite": "^7.1.6",
    "sass": "^1.49.7",
    "jest": "^30.1.3"
  },
  "browserslist": "last 2 versions, not IE 11",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch --mode development",
    "dist": "vite build --mode production",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "demo": "npm --prefix demo run capture",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:preview": "npm --prefix docs run preview",
    "create-subtheme": "node scripts/create-subtheme.mjs"
  }
}
