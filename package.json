{
  "name": "frame",
  "version": "1.0.0",
  "description": "Drupal base theme with a visual page builder (module inside) over Single Directory Components. React for interactive components, shared Vite and Jest config for subthemes.",
  "type": "module",
  "dependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.2",
    "babel-jest": "^30.1.2",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.5.2",
    "js-yaml": "^3.15.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.49.7",
    "vite": "^7.1.6"
  },
  "browserslist": "last 2 versions, not IE 11",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch --mode development",
    "dist": "vite build --mode production",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "demo": "npm --prefix demo run capture",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:preview": "npm --prefix docs run preview",
    "new": "node bin/frame.mjs new",
    "builder:install": "npm --prefix modules/frame_builder/editor ci",
    "builder:build": "npm --prefix modules/frame_builder/editor run build",
    "builder:watch": "npm --prefix modules/frame_builder/editor run watch",
    "builder:smoke": "npm --prefix demo run builder-smoke",
    "builder:e2e": "npm --prefix demo run e2e"
  },
  "bin": {
    "frame": "bin/frame.mjs"
  }
}
