<div{{ attributes.addClass('schema-probe') }} data-id="{{ id }}" data-kind="{{ kind }}" data-either="{{ either }}" data-flag="{{ flag is same as(false) ? 'no' : (flag ? 'yes' : 'unset') }}" data-tone="{{ tone }}" data-days="{{ days|default([])|join(',') }}" data-amount="{{ amount }}" data-here="{{ deep.a.b.c.here }}" data-e="{{ deep.a.b.c.d.e }}" data-mixed="{{ mixed }}" data-target="{{ target ? target.url ~ '|' ~ target.window : 'none' }}">{{ both }}{% for row in table %}<p>{{ row|join('|') }}</p>{% endfor %}</div>
