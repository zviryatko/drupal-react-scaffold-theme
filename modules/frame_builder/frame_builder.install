<?php

/**
 * @file
 * Install and status checks of Frame Builder.
 */

/**
 * Implements hook_requirements().
 *
 * The builder is a part of the Frame base theme: its preview is the
 * theme's markup, CSS and behaviors, and its components, tokens and features
 * come from the theme. It only works when the default theme is Frame
 * or a subtheme of it.
 */
function frame_builder_requirements($phase) {
  $requirements = [];
  if ($phase === 'runtime') {
    $supported = \Drupal::service('frame_builder.theme_kit')->isSupportedTheme();
    $default = \Drupal::config('system.theme')->get('default');
    $requirements['frame_builder_theme'] = [
      'title' => t('Frame Builder'),
      'value' => $supported
        ? t('Default theme %theme is based on Frame.', ['%theme' => $default])
        : t('Default theme %theme is not based on Frame', ['%theme' => $default]),
      'description' => $supported ? '' : t('The page builder is switched off: content types that use it are edited with the normal form. Make Frame or one of its subthemes the default theme.'),
      'severity' => $supported ? REQUIREMENT_OK : REQUIREMENT_WARNING,
    ];
    if (!file_exists(\Drupal::service('extension.list.module')->getPath('frame_builder') . '/js/editor.js')) {
      $requirements['frame_builder_assets'] = [
        'title' => t('Frame Builder editor'),
        'value' => t('Not built'),
        'description' => t('The editor is not compiled. Use a release archive of the theme, or run <code>npm run builder:build</code> in the Frame theme folder.'),
        'severity' => REQUIREMENT_ERROR,
      ];
    }
  }
  return $requirements;
}

/**
 * Adds the library of saved blocks.
 */
function frame_builder_update_11001() {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if (!$manager->getEntityType('frame_saved')) {
    $manager->installEntityType(\Drupal::entityTypeManager()->getDefinition('frame_saved'));
  }
}

/**
 * Adds the field that lists the paragraphs of a layout (with Paragraphs).
 */
function frame_builder_update_11002() {
  frame_builder_install_paragraphs_field();
}

/**
 * Adds the log of a saved block: who saved it, when, and why.
 */
function frame_builder_update_11003() {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if ($manager->getEntityType('frame_saved') && !$manager->getFieldStorageDefinition('log', 'frame_saved')) {
    $definition = \Drupal::service('entity_field.manager')->getBaseFieldDefinitions('frame_saved')['log'];
    $manager->installFieldStorageDefinition('log', 'frame_saved', 'frame_builder', $definition);
  }
}
