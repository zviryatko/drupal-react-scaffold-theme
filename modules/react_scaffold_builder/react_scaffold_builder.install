<?php

/**
 * @file
 * Install and status checks of React Scaffold Builder.
 */

/**
 * Implements hook_requirements().
 *
 * The builder is a part of the React Scaffold base theme: its preview is the
 * theme's markup, CSS and behaviors, and its components, tokens and features
 * come from the theme. It only works when the default theme is React Scaffold
 * or a subtheme of it.
 */
function react_scaffold_builder_requirements($phase) {
  $requirements = [];
  if ($phase === 'runtime') {
    $supported = \Drupal::service('react_scaffold_builder.theme_kit')->isSupportedTheme();
    $default = \Drupal::config('system.theme')->get('default');
    $requirements['react_scaffold_builder_theme'] = [
      'title' => t('React Scaffold Builder'),
      'value' => $supported
        ? t('Default theme %theme is based on React Scaffold.', ['%theme' => $default])
        : t('Default theme %theme is not based on React Scaffold', ['%theme' => $default]),
      'description' => $supported ? '' : t('The page builder is switched off: content types that use it are edited with the normal form. Make React Scaffold or one of its subthemes the default theme.'),
      'severity' => $supported ? REQUIREMENT_OK : REQUIREMENT_WARNING,
    ];
    if (!file_exists(\Drupal::service('extension.list.module')->getPath('react_scaffold_builder') . '/js/editor.js')) {
      $requirements['react_scaffold_builder_assets'] = [
        'title' => t('React Scaffold Builder editor'),
        'value' => t('Not built'),
        'description' => t('The editor is not compiled. Use a release archive of the theme, or run <code>npm run builder:build</code> in the React Scaffold theme folder.'),
        'severity' => REQUIREMENT_ERROR,
      ];
    }
  }
  return $requirements;
}

/**
 * Adds the library of saved blocks.
 */
function react_scaffold_builder_update_11001() {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if (!$manager->getEntityType('react_scaffold_saved')) {
    $manager->installEntityType(\Drupal::entityTypeManager()->getDefinition('react_scaffold_saved'));
  }
}

/**
 * Adds the field that lists the paragraphs of a layout (with Paragraphs).
 */
function react_scaffold_builder_update_11002() {
  react_scaffold_builder_install_paragraphs_field();
}

/**
 * Adds the log of a saved block: who saved it, when, and why.
 */
function react_scaffold_builder_update_11003() {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if ($manager->getEntityType('react_scaffold_saved') && !$manager->getFieldStorageDefinition('log', 'react_scaffold_saved')) {
    $definition = \Drupal::service('entity_field.manager')->getBaseFieldDefinitions('react_scaffold_saved')['log'];
    $manager->installFieldStorageDefinition('log', 'react_scaffold_saved', 'react_scaffold_builder', $definition);
  }
}
