<?php

/**
 * @file
 * Frame Demo subtheme.
 *
 * The CSRF token for apiClient() is provided by the base theme.
 */

/**
 * Implements hook_preprocess_HOOK() for page_title.
 *
 * Wraps the page title in the react-tooltip SDC.
 */
function frame_demo_preprocess_page_title(&$variables) {
  $title = $variables['title'];
  // Slots accept render arrays or scalars only, titles may be markup objects.
  if (!is_array($title) && !is_scalar($title)) {
    $title = ['#markup' => $title];
  }
  $variables['title'] = [
    '#type' => 'component',
    '#component' => 'frame_demo:react-tooltip',
    '#props' => [
      'text' => 'This title is a React component (react-tippy tooltip)',
    ],
    '#slots' => [
      'content' => $title,
    ],
  ];
}
