{#
/**
 * @file
 * Mounts the React node-list SDC on the content_rest page display.
 */
#}
{% set classes = ['view', 'view-' ~ id|clean_class, 'view-id-' ~ id, 'view-display-id-' ~ display_id] %}
<div{{ attributes.addClass(classes) }}>
  {% include 'react_scaffold:node-list' with {
    endpoint: path('view.content_rest.better_rest_export_1'),
    variant: 'light',
  } only %}
</div>
